APP_NAME=QuantumShield
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# This machine's PostgreSQL service was detected on port 5433.
# Replace CHANGE_ME with your URL-encoded PostgreSQL password.
# This example does not change PostgreSQL authentication.
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD_HERE@127.0.0.1:5433/quantumshield

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required, with no insecure default. Generate once for local development:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Base64 encoding of exactly 32 random bytes. Generate once for a NEW dataset:
# python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Restore the original key for existing encrypted data; never regenerate at startup.
MASTER_KEY_BASE64=CHANGE_ME
DEFAULT_SECURITY_LEVEL=STANDARD
DEFAULT_SIGNATURE_ALGORITHM=ML-DSA-65

STORAGE_PATH=storage/files
MAX_UPLOAD_SIZE_MB=25
LOG_LEVEL=INFO
